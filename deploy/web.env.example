# Biến môi trường cho Next.js (web/) khi chạy trên VPS.
# Copy file này thành web/.env.production rồi sửa giá trị thật:
#   cp deploy/web.env.example web/.env.production
#
# QUAN TRỌNG: các biến NEXT_PUBLIC_* được Next.js nhúng cứng vào bundle
# tại thời điểm `npm run build`. Sửa file này mà không build lại thì web
# vẫn chạy giá trị cũ.

# Domain API công khai (Laravel). KHÔNG có dấu "/" ở cuối.
NEXT_PUBLIC_API_URL=https://api.sophchem.com/api

# Domain công khai của website (dùng cho canonical, OG image, sitemap, robots).
# Phải khớp đúng domain canonical, KHÔNG có dấu "/" ở cuối.
NEXT_PUBLIC_SITE_URL=https://www.sophchem.com
